# =============================================================================
# .gitignore — AI LLM Proxy Project
# =============================================================================

# Environment variables (contains secrets!)
.env
*.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
docker-logs.txt
qwen3-coder-next-engine.logs
logs/

# Data directories (volumes)
langfuse-postgres-data/
langfuse-clickhouse-data/
langfuse-clickhouse-logs/
langfuse-minio-data/
langfuse-redis-data/
qdrant-storage/
.cache/

# HuggingFace cache
.huggingface/
.huggingface/*
~/.cache/huggingface/

# Generated files
.env.backup
*.bak
.clinerules

# Python bytecode cache
__pycache__/
*.pyc
agentgateway/data/
*.bak-*

# Evaluation runs (scripts/eval-agentic-tasks.py, scripts/eval-hard-problems.py)
# The results JSON and each attempt's final workspace are kept; the last-green
# checkpoint copies and half-written temp files are not.
*.json.tmp
ai-workspace/reports/agentic-eval-*/**/last_green/
.pytest_cache/
